# OBSERVER — Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── SMTP Configuration ──────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ariceredhod3@gmail.com
SMTP_PASS=jtrc djfn zfka jmij
SMTP_FROM_NAME=OBSERVER Security

# ─── Application Security ────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-64-char-hex-string
JWT_EXPIRE_HOURS=168

# ─── OTP Configuration ───────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6

# ─── Rate Limiting ───────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ─── Database ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL blank — the app automatically uses:
#   Windows: %LOCALAPPDATA%\OBSERVER\observer.db
#   Linux/Mac: ~/.local/share/OBSERVER/observer.db
# This guarantees dev (python main.py) and the .exe share the exact same DB.
# Only override this if you want to use a different database (e.g. PostgreSQL).
DATABASE_URL=

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
SMTP_FROM=
